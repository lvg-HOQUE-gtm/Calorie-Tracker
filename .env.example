# Copy this file to .env and fill in the anon key.
# Do not put spaces or quotes around values (this breaks Expo env loading):
#   WRONG: EXPO_PUBLIC_SUPABASE_ANON_KEY= 'eyJ...'
#   RIGHT: EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
#
# Keys: Supabase Dashboard -> Project Settings -> API
# Project: https://fvfdegfouopldcmqwpzk.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://fvfdegfouopldcmqwpzk.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: There is intentionally no EXPO_PUBLIC_GEMINI_KEY here.
# The Gemini API key must NEVER be shipped to the client. It lives only as a
# Supabase Edge Function secret named GEMINI_API_KEY, set via:
#   Supabase Dashboard -> Edge Functions -> Secrets
# or:
#   supabase secrets set GEMINI_API_KEY=your-key
# The app calls the deployed "analyze-meal" Edge Function instead of Gemini
# directly, so the key never leaves the server.
